---
/**
 * /devices — Browse all devices that have at least one guide.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllDevices, getGuidesByDevice } from '../utils/guides';

const devices = await getAllDevices();

// Build counts per device
const deviceData = await Promise.all(
  devices.map(async ({ slug, label }) => {
    const guides = await getGuidesByDevice(slug);
    return { slug, label, count: guides.length };
  })
);
---

<BaseLayout title="Browse by Device" description="Find setup guides organised by device type.">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10">

    <nav class="text-sm text-slate-500 mb-6 flex gap-1 items-center">
      <a href="/" class="hover:text-brand-600">Home</a>
      <span>›</span>
      <span class="text-slate-700">Devices</span>
    </nav>

    <h1 class="text-3xl font-bold text-slate-900 mb-2">Browse by device</h1>
    <p class="text-slate-500 mb-10">Pick the device your child uses to see all available guides.</p>

    {deviceData.length === 0 ? (
      <p class="text-slate-500">No guides yet — check back soon.</p>
    ) : (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {deviceData.map(({ slug, label, count }) => (
          <a href={`/device/${slug}`} class="card-link flex flex-col gap-2">
            <span class="font-semibold text-slate-800 group-hover:text-brand-700">{label}</span>
            <span class="text-sm text-slate-500">{count} guide{count !== 1 ? 's' : ''}</span>
          </a>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
