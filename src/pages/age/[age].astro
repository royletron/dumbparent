---
/**
 * /age/[age] — Browse guides for a specific age group.
 *
 * Statically generated for each value in AGE_GROUPS.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideCard from '../../components/GuideCard.astro';
import { AGE_GROUPS, AGE_GROUP_LABELS } from '../../content/config';
import type { AgeGroup } from '../../content/config';
import { getGuidesByAge, getAllDevices } from '../../utils/guides';

export async function getStaticPaths() {
  return AGE_GROUPS.map((age) => ({ params: { age } }));
}

const { age } = Astro.params as { age: AgeGroup };
const guides  = await getGuidesByAge(age);
const label   = AGE_GROUP_LABELS[age];

// Group guides by device for a cleaner layout
const byDevice = guides.reduce<Record<string, typeof guides>>((acc, g) => {
  const key = g.data.deviceLabel;
  (acc[key] ??= []).push(g);
  return acc;
}, {});
---

<BaseLayout title={`Guides for ${label}`} description={`Device and app setup guides for children aged ${label}.`}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10">

    <!-- Breadcrumb -->
    <nav class="text-sm text-slate-500 mb-6 flex gap-1 items-center">
      <a href="/" class="hover:text-brand-600">Home</a>
      <span>›</span>
      <span class="text-slate-700">{label}</span>
    </nav>

    <h1 class="text-3xl font-bold text-slate-900 mb-2">Guides for {label}</h1>
    <p class="text-slate-500 mb-10">
      {guides.length === 0
        ? 'No guides yet for this age group — check back soon.'
        : `${guides.length} guide${guides.length !== 1 ? 's' : ''} for this age group, grouped by device.`}
    </p>

    <!-- Age group switcher -->
    <div class="flex flex-wrap gap-2 mb-10">
      {AGE_GROUPS.map((a) => (
        <a
          href={`/age/${a}`}
          class={`text-sm px-4 py-1.5 rounded-full border transition-colors
            ${a === age
              ? 'bg-brand-600 text-white border-brand-600'
              : 'border-slate-300 text-slate-600 hover:border-brand-400 hover:text-brand-600'}`}
        >
          {AGE_GROUP_LABELS[a]}
        </a>
      ))}
    </div>

    {guides.length > 0 && (
      <div class="space-y-12">
        {Object.entries(byDevice).map(([deviceLabel, deviceGuides]) => (
          <section>
            <h2 class="text-lg font-semibold text-slate-800 mb-4 flex items-center gap-2">
              <span class="w-1 h-5 bg-brand-500 rounded-full" aria-hidden="true"></span>
              {deviceLabel}
            </h2>
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {deviceGuides.map((guide) => <GuideCard guide={guide} />)}
            </div>
          </section>
        ))}
      </div>
    )}

  </div>
</BaseLayout>
