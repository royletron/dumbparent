---
/**
 * BaseLayout.astro
 *
 * The outer shell used by every page. Includes the global nav, footer,
 * and imports the global stylesheet.
 *
 * Props:
 *   title       - Page <title> (will be appended with " | Dumb Parent")
 *   description - Meta description for SEO
 */

import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Simple guides for parents to safely set up devices and apps for their kids.' } = Astro.props;
const fullTitle = `${title} | Dumb Parent`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Inter font from Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Accessibility: skip to main content -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- ── Top colour accent strip ───────────────────────────────── -->
    <div class="h-1 bg-gradient-to-r from-brand-400 via-brand-500 to-sky-400" aria-hidden="true"></div>

    <!-- ── Navigation ─────────────────────────────────────────────── -->
    <header class="border-b border-slate-200 bg-white/95 backdrop-blur-sm sticky top-0 z-40">
      <nav class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between" aria-label="Main navigation">
        <a href="/" class="flex items-center gap-2.5 font-bold text-xl text-slate-900 hover:text-brand-700 transition-colors">
          <!-- Heart icon — friendly & family-oriented -->
          <span class="h-8 w-8 rounded-lg bg-brand-500 flex items-center justify-center shadow-sm shrink-0" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white" viewBox="0 0 24 24" fill="currentColor">
              <path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 0 1-.383-.218 25.18 25.18 0 0 1-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0 1 12 5.052 5.5 5.5 0 0 1 16.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 0 1-4.244 3.17 15.247 15.247 0 0 1-.383.219l-.022.012-.007.004-.003.001a.752.752 0 0 1-.704 0l-.003-.001Z" />
            </svg>
          </span>
          Dumb Parent
        </a>
        <ul class="flex items-center gap-1 text-sm font-medium text-slate-600">
          <li><a href="/age/under-5" class="px-3 py-1.5 rounded-lg hover:bg-brand-50 hover:text-brand-700 transition-colors">By Age</a></li>
          <li><a href="/devices"     class="px-3 py-1.5 rounded-lg hover:bg-brand-50 hover:text-brand-700 transition-colors">By Device</a></li>
          <li><a href="/apps"        class="px-3 py-1.5 rounded-lg hover:bg-brand-50 hover:text-brand-700 transition-colors">By App</a></li>
        </ul>
      </nav>
    </header>

    <!-- ── Page content ───────────────────────────────────────────── -->
    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <!-- ── Footer ─────────────────────────────────────────────────── -->
    <footer class="bg-slate-900 text-slate-400 mt-16">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
        <div class="flex flex-col sm:flex-row justify-between gap-8 pb-8 border-b border-slate-700/60">
          <!-- Brand blurb -->
          <div class="max-w-xs">
            <div class="flex items-center gap-2 text-white font-bold text-lg mb-2">
              <span class="h-7 w-7 rounded-lg bg-brand-500 flex items-center justify-center shrink-0" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-white" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 0 1-.383-.218 25.18 25.18 0 0 1-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0 1 12 5.052 5.5 5.5 0 0 1 16.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 0 1-4.244 3.17 15.247 15.247 0 0 1-.383.219l-.022.012-.007.004-.003.001a.752.752 0 0 1-.704 0l-.003-.001Z" />
                </svg>
              </span>
              Dumb Parent
            </div>
            <p class="text-sm leading-relaxed">
              A free resource helping parents keep their kids safer online.
              Guides are community-maintained — always double-check with the latest
              official documentation.
            </p>
          </div>
          <!-- Nav columns -->
          <div class="flex gap-10 text-sm shrink-0">
            <div>
              <p class="font-semibold text-slate-300 mb-3">Browse guides</p>
              <ul class="space-y-2">
                <li><a href="/age/under-5" class="hover:text-white transition-colors">By Age</a></li>
                <li><a href="/devices"     class="hover:text-white transition-colors">By Device</a></li>
                <li><a href="/apps"        class="hover:text-white transition-colors">By App</a></li>
              </ul>
            </div>
            <div>
              <p class="font-semibold text-slate-300 mb-3">Contribute</p>
              <ul class="space-y-2">
                <li>
                  <a
                    href="https://github.com/royletron/dumbparent"
                    class="hover:text-white transition-colors"
                    target="_blank"
                    rel="noopener noreferrer"
                  >GitHub →</a>
                </li>
              </ul>
            </div>
          </div>
        </div>
        <p class="mt-6 text-xs text-center text-slate-600">
          © {new Date().getFullYear()} Dumb Parent. Made with care for families everywhere.
        </p>
      </div>
    </footer>
  </body>
</html>
