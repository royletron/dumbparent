---
/**
 * BaseLayout.astro
 *
 * The outer shell used by every page. Includes the global nav, footer,
 * and imports the global stylesheet.
 *
 * Props:
 *   title       - Page <title> (will be appended with " | Dumb Parent")
 *   description - Meta description for SEO
 */

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Simple guides for parents to safely set up devices and apps for their kids.' } = Astro.props;
const fullTitle = `${title} | Dumb Parent`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Inter font from Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Accessibility: skip to main content -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- ── Navigation ─────────────────────────────────────────── -->
    <header class="border-b border-slate-200 bg-white sticky top-0 z-40">
      <nav class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between" aria-label="Main navigation">
        <a href="/" class="flex items-center gap-2 font-bold text-xl text-brand-700 hover:text-brand-600 transition-colors">
          <!-- Simple shield icon -->
          <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-brand-500" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M12 1.5a.75.75 0 0 1 .696.47l1.93 4.674 4.994.607a.75.75 0 0 1 .416 1.282l-3.65 3.428.908 4.933a.75.75 0 0 1-1.09.812L12 14.974l-4.204 2.732a.75.75 0 0 1-1.09-.812l.908-4.933-3.65-3.428a.75.75 0 0 1 .416-1.282l4.994-.607 1.93-4.673A.75.75 0 0 1 12 1.5Z" clip-rule="evenodd" />
          </svg>
          Dumb Parent
        </a>
        <ul class="flex items-center gap-6 text-sm font-medium text-slate-600">
          <li><a href="/age/under-5"   class="hover:text-brand-600 transition-colors">By Age</a></li>
          <li><a href="/devices"       class="hover:text-brand-600 transition-colors">By Device</a></li>
          <li><a href="/apps"          class="hover:text-brand-600 transition-colors">By App</a></li>
        </ul>
      </nav>
    </header>

    <!-- ── Page content ───────────────────────────────────────── -->
    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <!-- ── Footer ─────────────────────────────────────────────── -->
    <footer class="border-t border-slate-200 bg-slate-50 mt-16">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 text-center text-sm text-slate-500">
        <p>
          Dumb Parent is a free resource to help parents keep their kids safer online.
          Guides are community-maintained — always double-check settings with the latest
          official documentation from the app or device maker.
        </p>
        <p class="mt-3">
          Found an error or want to contribute?
          <a
            href="https://github.com/royletron/dumbparent"
            class="text-brand-600 hover:underline"
            target="_blank"
            rel="noopener noreferrer"
          >
            Open an issue on GitHub
          </a>
        </p>
      </div>
    </footer>
  </body>
</html>
