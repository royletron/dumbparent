---
/**
 * GuideLayout.astro
 *
 * Layout used by every individual guide page (src/pages/guides/[...slug].astro).
 * Renders the guide's metadata header (badges, companion info, risk level) and
 * then the MDX body content.
 *
 * Props:
 *   guide - The CollectionEntry<'guides'> object from getCollection('guides')
 */

import BaseLayout from './BaseLayout.astro';
import RiskBadge from '../components/RiskBadge.astro';
import AgeTag from '../components/AgeTag.astro';
import DifficultyBadge from '../components/DifficultyBadge.astro';
import CompanionBox from '../components/CompanionBox.astro';
import type { CollectionEntry } from 'astro:content';
import { AGE_GROUP_LABELS } from '../content/config';

interface Props {
  guide: CollectionEntry<'guides'>;
}

const { guide } = Astro.props;
const { data } = guide;
---

<BaseLayout title={data.title} description={data.description}>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-10">

    <!-- ── Breadcrumb ──────────────────────────────────────────── -->
    <nav class="text-sm text-slate-500 mb-6 flex flex-wrap gap-1 items-center" aria-label="Breadcrumb">
      <a href="/" class="hover:text-brand-600">Home</a>
      <span aria-hidden="true">›</span>
      <a href={`/device/${data.device}`} class="hover:text-brand-600">{data.deviceLabel}</a>
      {data.app !== 'device-setup' && (
        <>
          <span aria-hidden="true">›</span>
          <a href={`/app/${data.app}`} class="hover:text-brand-600">{data.appLabel}</a>
        </>
      )}
      <span aria-hidden="true">›</span>
      <span class="text-slate-700">{data.title}</span>
    </nav>

    <!-- ── Guide header ───────────────────────────────────────── -->
    <header class="mb-8">
      <!-- Title -->
      <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-3 leading-tight">
        {data.title}
      </h1>
      <p class="text-lg text-slate-600 mb-5">{data.description}</p>

      <!-- Meta badges row -->
      <div class="flex flex-wrap gap-2 items-center mb-5">
        <RiskBadge level={data.riskLevel} />
        <DifficultyBadge level={data.difficulty} />
        <!-- Age groups -->
        {data.ageGroups.map((age) => (
          <AgeTag age={age} label={AGE_GROUP_LABELS[age]} />
        ))}
        <!-- Time required -->
        <span class="inline-flex items-center gap-1 text-xs font-medium bg-slate-100 text-slate-600 px-2.5 py-1 rounded-full">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          {data.timeRequired}
        </span>
      </div>

      <!-- Risk summary callout (if provided) -->
      {data.riskSummary && (
        <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 text-sm text-amber-800 flex gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 text-amber-500 mt-0.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 10 5zm0 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2z" clip-rule="evenodd" />
          </svg>
          <p><strong>What to watch out for:</strong> {data.riskSummary}</p>
        </div>
      )}

      <!-- Last updated -->
      <p class="text-xs text-slate-400 mt-4">
        Last reviewed:
        <time datetime={data.lastUpdated.toISOString()}>
          {data.lastUpdated.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
      </p>
    </header>

    <!-- ── Companion requirement box ─────────────────────────── -->
    {data.companionRequired && (
      <CompanionBox
        devices={data.companionDevices}
        apps={data.companionApps}
      />
    )}

    <!-- ── Guide body (MDX content) ──────────────────────────── -->
    <!-- The `prose` class from @tailwindcss/typography styles the MDX output. -->
    <div class="prose prose-slate prose-lg max-w-none
                prose-headings:font-semibold
                prose-a:text-brand-600 prose-a:no-underline hover:prose-a:underline
                prose-img:rounded-lg prose-img:shadow-md">
      <slot />
    </div>

    <!-- ── Footer nav ─────────────────────────────────────────── -->
    <footer class="mt-12 pt-8 border-t border-slate-200 flex justify-between text-sm">
      <a href={`/device/${data.device}`} class="text-brand-600 hover:underline">
        ← All {data.deviceLabel} guides
      </a>
      {data.app !== 'device-setup' && (
        <a href={`/app/${data.app}`} class="text-brand-600 hover:underline">
          All {data.appLabel} guides →
        </a>
      )}
    </footer>

  </article>
</BaseLayout>
