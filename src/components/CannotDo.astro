---
/**
 * CannotDo.astro
 *
 * A single "child CANNOT do this" row inside a <WhatToExpect> section.
 * Renders with a red X.
 */
---

<div class="flex items-start gap-2.5 text-sm text-slate-700 py-1">
  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-red-400 shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor" aria-label="Cannot do">
    <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
  </svg>
  <span><slot /></span>
</div>
