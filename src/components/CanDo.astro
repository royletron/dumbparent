---
/**
 * CanDo.astro
 *
 * A single "child CAN do this" row inside a <WhatToExpect> section.
 * Renders with a green checkmark.
 */
---

<div class="flex items-start gap-2.5 text-sm text-slate-700 py-1">
  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-green-500 shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor" aria-label="Can do">
    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
  </svg>
  <span><slot /></span>
</div>
