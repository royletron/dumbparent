---
/**
 * GuideCard.astro
 *
 * Summary card for a guide, used on browse/index pages.
 *
 * Props:
 *   guide - CollectionEntry<'guides'>
 */

import type { CollectionEntry } from 'astro:content';
import RiskBadge from './RiskBadge.astro';
import DifficultyBadge from './DifficultyBadge.astro';

interface Props {
  guide: CollectionEntry<'guides'>;
}

const { guide } = Astro.props;
const { data, slug } = guide;
---

<a href={`/guides/${slug}`} class="card-link group flex flex-col gap-3">
  <!-- Device / App labels -->
  <div class="flex items-center gap-1.5 text-xs text-slate-500">
    <span class="font-medium text-slate-700">{data.deviceLabel}</span>
    {data.app !== 'device-setup' && (
      <>
        <span aria-hidden="true">·</span>
        <span>{data.appLabel}</span>
      </>
    )}
  </div>

  <!-- Title -->
  <h3 class="font-semibold text-slate-900 group-hover:text-brand-700 transition-colors leading-snug">
    {data.title}
  </h3>

  <!-- Description -->
  <p class="text-sm text-slate-600 line-clamp-2">{data.description}</p>

  <!-- Badges row -->
  <div class="flex flex-wrap gap-1.5 mt-auto pt-1">
    <RiskBadge level={data.riskLevel} />
    <DifficultyBadge level={data.difficulty} />
    <span class="inline-flex items-center text-xs text-slate-500">
      ⏱ {data.timeRequired}
    </span>
  </div>
</a>
